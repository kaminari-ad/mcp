# Files NEVER copied into the build context. Keeps the kaniko / buildkit
# layer cache small and prevents host-only artefacts from leaking into
# the production image.
#
# IMPORTANT: files referenced by COPY instructions in Dockerfile MUST
# NOT be excluded here. The runtime stage COPYs `package.json`,
# `LICENSE`, `README.md`, `SECURITY.md` for npm-publish parity — those
# four MUST stay in the build context. Anything else that doesn't end
# up in `dist/` or `node_modules/` is fair game.

# Build artefacts and caches.
node_modules
dist
coverage
.git
.gitlab-ci.yml
.gitignore
.gitattributes
.dockerignore
.nvmrc

# Editors / IDE.
.github
.cursor
.vscode
.idea

# Secrets / logs (defense in depth — they should never be committed,
# but if a contributor accidentally checked one in, this stops it
# from landing in the production image).
*.log
.env
.env.*
!.env.example

# Test / docs / tooling that's never needed at runtime.
tests
scripts
docs
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
.eslintrc*
eslint.config.*
.prettierrc*
.prettierignore
lefthook.yml
commitlint.config.*
renovate.json
.dependency-cruiser.cjs
docker-compose.dev.yml
Makefile

# All env vars carry the `KAMINARI_AD_` namespace prefix so they cannot
# collide with generic names from other tools sharing the same shell
# (Docker compose, k8s pod, Cursor, Claude Desktop).

# ── stdio mode (local install) ──────────────────────────────────────
# Required in stdio mode. Bearer API key generated in
#   Kaminari Ad UI -> Settings -> API Keys.
# Format: `secrets.token_urlsafe(32)` from the API — a 43-char URL-safe
# string with no fixed prefix.
# REJECTED in HTTP mode on startup (process exits non-zero) — see
# CONTRIBUTING.md "Tenant isolation" §5.
KAMINARI_AD_API_KEY=

# ── Both modes ───────────────────────────────────────────────────────
# Which transport to start. `stdio` is the default and used by local
# MCP hosts (Cursor, Claude Desktop). `http` is the multi-tenant
# hosted endpoint behind nginx.
KAMINARI_AD_TRANSPORT=stdio

# Base URL of the Kaminari Ad API. Defaults to https://app.kaminari.ad
# in stdio mode (the production API host — note the `app.` subdomain;
# the bare `kaminari.ad` is the marketing landing page only). The
# docker-compose HTTP service overrides this to http://api:8000.
KAMINARI_AD_API_URL=https://app.kaminari.ad

# pino log level. One of: trace | debug | info | warn | error | fatal.
KAMINARI_AD_LOG_LEVEL=info

# pino output format. One of: pretty | json.
# Default is transport-dependent: `pretty` in stdio mode (terminal),
# `json` in http mode (aggregator). MCP hosts that capture stderr from
# the stdio process (Cursor, Claude Desktop) parse better with `json` —
# set this explicitly when the operator is a machine, not a human.
# KAMINARI_AD_LOG_FORMAT=pretty

# ── HTTP mode only ───────────────────────────────────────────────────
# Port the HTTP transport listens on. Bound to 0.0.0.0 inside the
# container, exposed only to the internal Docker network. nginx
# terminates TLS in front.
KAMINARI_AD_HTTP_PORT=8080

# Per-tenant rate limit. Tokens-per-minute (leaky bucket) keyed by
# sha256(bearer). 120 = 2 RPS sustained, room for short bursts.
KAMINARI_AD_RATE_LIMIT_RPM=120

# ── OAuth discovery (HTTP mode) ──────────────────────────────────────
# These four vars drive the RFC 9728 Protected Resource Metadata
# endpoint at /.well-known/oauth-protected-resource and the
# WWW-Authenticate Bearer challenge attached to 401s. All four have
# production defaults that match https://mcp.kaminari.ad — override
# only for staging / local Docker / standalone hosts that point at
# a different Authorization Server.

# Canonical resource identifier echoed in the PRM document and used
# by OAuth clients to bind tokens to this resource server (audience).
# Defaults to https://mcp.kaminari.ad.
# KAMINARI_AD_OAUTH_PROTECTED_RESOURCE=https://mcp.kaminari.ad

# Public URL of the PRM document itself. MUST be reachable
# unauthenticated. Claude reads this URL from the WWW-Authenticate
# challenge to discover the AS.
# Defaults to https://mcp.kaminari.ad/.well-known/oauth-protected-resource.
# KAMINARI_AD_OAUTH_PROTECTED_RESOURCE_METADATA_URL=https://mcp.kaminari.ad/.well-known/oauth-protected-resource

# Base URL of the OAuth Authorization Server, advertised in
# `authorization_servers[]` of the PRM document. Defaults to
# https://app.kaminari.ad. Clients append /.well-known/oauth-
# authorization-server to fetch the RFC 8414 AS metadata.
# KAMINARI_AD_OAUTH_AUTHORIZATION_SERVER_URL=https://app.kaminari.ad

# Space-separated list of OAuth 2.0 scope strings this resource
# server accepts. Defaults to the seven MCP scopes plus
# `offline_access` from oauth-scope-catalogue.ts. Override only when
# you need to restrict what scopes the PRM advertises (e.g. a
# read-only deployment).
# KAMINARI_AD_OAUTH_SCOPES="mcp:scans:read mcp:scans:write mcp:campaigns:read mcp:campaigns:write mcp:billing:read mcp:webhooks:write offline_access"

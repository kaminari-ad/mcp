# ── stdio mode (local install) ──
# Required in stdio mode. Bearer API key generated in Kaminari Ad UI -> Settings -> API Keys.
# Format: kad_<32 url-safe base64 chars>.
# REJECTED in HTTP mode on startup (process exits non-zero).
KAMINARI_AD_API_KEY=

# ── Both modes ──
# Base URL of the Kaminari Ad API. Defaults to https://kaminari.ad in stdio mode;
# in Docker compose HTTP mode this is overridden to http://api:8000.
API_BASE_URL=https://kaminari.ad

# pino log level. One of: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# ── HTTP mode only ──
# Port the HTTP transport listens on. Bound to 0.0.0.0 inside container,
# exposed only to the internal Docker network. nginx terminates TLS.
HTTP_PORT=8080

# Session idle TTL in seconds. After this much idle time a session is destroyed
# and its session-id is no longer accepted. Default: 30 minutes.
SESSION_TTL_SEC=1800

# Per-tenant rate limit. Tokens-per-minute (leaky bucket) keyed by sha256(bearer).
RATE_LIMIT_RPM=120
